{
  "$id": "https://contracts.auteric.dev/schemas/pricing/get_price.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "quantity": {
      "maximum": 999,
      "minimum": 1,
      "type": "integer"
    },
    "variant_id": {
      "$ref": "../common/ids.json#/$defs/variant_id"
    }
  },
  "required": [
    "variant_id"
  ],
  "type": "object"
}
