{
  "bindings": {
    "auteric_mcp": "complete_checkout",
    "ucp": "dev.ucp.shopping.checkout"
  },
  "concurrency": {
    "applies_to": "checkout",
    "mode": "resource_revision"
  },
  "contract_version": "1.0.0",
  "description": "Complete a ready checkout through a configured payment handler.",
  "idempotency": "required",
  "identity": "buyer_or_guest_principal",
  "merchant_http": {
    "method": "POST",
    "path": "/api/auteric/v1/checkouts/{checkout_id}/complete"
  },
  "operation": "complete_checkout",
  "ownership": {
    "resource": "checkout",
    "rule": "principal_must_own_checkout"
  },
  "release_stage": "current",
  "requires": [
    "reviewed_mapping",
    "contract_test",
    "policy",
    "runtime_activation",
    "ownership",
    "idempotency",
    "configured_payment_handler",
    "encrypted_sensitive_payload"
  ],
  "schemas": {
    "input": "schemas/checkout/complete_checkout.input.json",
    "output": "schemas/checkout/complete_checkout.output.json"
  },
  "side_effect": "write",
  "test_scenarios": [
    "happy: ready checkout completes and returns the created order",
    "payment timeout after possible capture returns EXECUTION_UNCERTAIN (never auto-retry blindly)",
    "payment in flight returns PAYMENT_PENDING and must not be shown as completed",
    "no payment handler configured returns CAPABILITY_DISABLED",
    "stale expected_revision returns REVISION_CONFLICT"
  ]
}
