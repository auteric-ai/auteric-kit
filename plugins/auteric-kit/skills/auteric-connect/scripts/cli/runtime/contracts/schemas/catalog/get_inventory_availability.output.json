{
  "$id": "https://contracts.auteric.dev/schemas/catalog/get_inventory_availability.output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "available": {
      "type": "boolean"
    },
    "policy": {
      "enum": [
        "deny",
        "continue"
      ],
      "type": "string"
    },
    "quantity": {
      "minimum": 0,
      "type": "integer"
    },
    "updated_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "variant_id": {
      "$ref": "../common/ids.json#/$defs/variant_id"
    }
  },
  "required": [
    "variant_id",
    "available",
    "updated_at"
  ],
  "type": "object"
}
