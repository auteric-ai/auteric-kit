{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "connection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "auteric-connection/v1"
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9.-]+[a-z0-9]$"
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "sandbox",
        "staging",
        "production"
      ]
    },
    "control_origin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "store_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "runtime_release": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transport": {
          "const": "http"
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "transport",
        "origin"
      ]
    },
    "mapping_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mapping": {
      "oneOf": [
        {
          "$ref": "bridge-mapping.schema.json"
        },
        {
          "$ref": "module-binding.schema.json"
        }
      ]
    }
  },
  "required": [
    "schema",
    "domain",
    "environment",
    "control_origin",
    "store_id",
    "installation_id",
    "runtime_release",
    "backend",
    "mapping_digest",
    "mapping"
  ]
}
