{
  "name": "@auteric/cli",
  "version": "0.7.2",
  "description": "Connect a custom storefront to an Auteric Commerce control plane",
  "type": "module",
  "bin": {
    "auteric": "./bin/auteric.js"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md",
    "runtime/manifest.json",
    "runtime/contracts/registry.json",
    "runtime/contracts/registry/operations/*.json",
    "runtime/contracts/generated.ts",
    "runtime/sdk/pyproject.toml",
    "runtime/sdk/src/**/*.py",
    "runtime/sdk/src/**/*.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:package": "node scripts/check-package.js"
  }
}
