{
  "name": "@auteric/cli",
  "version": "0.6.5-rc.3",
  "description": "Connect a custom storefront to an Auteric Commerce control plane",
  "type": "module",
  "bin": {
    "auteric": "./bin/auteric.js"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md",
    "runtime/manifest.json",
    "runtime/contracts/registry.json",
    "runtime/contracts/registry/operations/*.json",
    "runtime/contracts/generated.ts",
    "runtime/sdk/pyproject.toml",
    "runtime/sdk/src/**/*.py",
    "runtime/sdk/src/**/*.md",
    "runtime/merchant-node",
    "runtime/merchant-python",
    "runtime/contracts/schemas",
    "runtime/pilot",
    "runtime/pilot-manifest.json",
    "runtime/contracts/registry/registry.json",
    "runtime/verify_profile.py",
    "PILOT.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:package": "node scripts/check-package.js",
    "bundle:pilot": "python3 scripts/bundle-pilot.py"
  }
}
