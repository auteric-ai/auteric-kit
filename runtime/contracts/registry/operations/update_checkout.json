{
  "bindings": {
    "auteric_mcp": "update_checkout",
    "ucp": "dev.ucp.shopping.checkout"
  },
  "concurrency": {
    "applies_to": "checkout",
    "mode": "resource_revision"
  },
  "contract_version": "1.0.0",
  "description": "Update buyer, fulfillment and checkout context.",
  "idempotency": "required",
  "identity": "buyer_or_guest_principal",
  "merchant_http": {
    "method": "PATCH",
    "path": "/api/auteric/v1/checkouts/{checkout_id}"
  },
  "operation": "update_checkout",
  "ownership": {
    "resource": "checkout",
    "rule": "principal_must_own_checkout"
  },
  "release_stage": "current",
  "requires": [
    "reviewed_mapping",
    "contract_test",
    "policy",
    "runtime_activation",
    "ownership",
    "idempotency"
  ],
  "schemas": {
    "input": "schemas/checkout/update_checkout.input.json",
    "output": "schemas/checkout/update_checkout.output.json"
  },
  "side_effect": "write",
  "test_scenarios": [
    "happy: buyer_principal or shipping context updated",
    "terminal checkout rejects updates with INVALID_INPUT",
    "stale expected_revision returns REVISION_CONFLICT",
    "idempotent retry with same action_id returns stored result"
  ]
}
