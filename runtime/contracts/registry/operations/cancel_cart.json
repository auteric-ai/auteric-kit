{
  "bindings": {
    "auteric_mcp": "cancel_cart",
    "ucp": "dev.ucp.shopping.cart"
  },
  "concurrency": {
    "applies_to": "cart",
    "mode": "resource_revision"
  },
  "contract_version": "1.0.0",
  "description": "Cancel an agent-owned cart.",
  "idempotency": "required",
  "identity": "buyer_or_guest_principal",
  "merchant_http": {
    "method": "POST",
    "path": "/api/auteric/v1/carts/{cart_id}/cancel"
  },
  "operation": "cancel_cart",
  "ownership": {
    "resource": "cart",
    "rule": "principal_must_own_cart"
  },
  "release_stage": "current",
  "requires": [
    "reviewed_mapping",
    "contract_test",
    "policy",
    "runtime_activation",
    "ownership",
    "idempotency"
  ],
  "schemas": {
    "input": "schemas/cart/cancel_cart.input.json",
    "output": "schemas/cart/cancel_cart.output.json"
  },
  "side_effect": "write",
  "test_scenarios": [
    "happy: active cart transitions to cancelled",
    "already-converted cart returns INVALID_INPUT or REVISION_CONFLICT per policy",
    "idempotent retry returns the stored cancelled cart",
    "foreign principal cannot cancel another principal's cart"
  ]
}
