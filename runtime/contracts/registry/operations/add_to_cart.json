{
  "bindings": {
    "auteric_mcp": "add_to_cart",
    "ucp": "dev.ucp.shopping.cart"
  },
  "concurrency": {
    "applies_to": "cart",
    "mode": "resource_revision"
  },
  "contract_version": "1.0.0",
  "description": "Add a sellable item to an agent-owned cart.",
  "idempotency": "required",
  "identity": "buyer_or_guest_principal",
  "merchant_http": {
    "method": "POST",
    "path": "/api/auteric/v1/carts/{cart_id}/items"
  },
  "operation": "add_to_cart",
  "ownership": {
    "resource": "cart",
    "rule": "principal_must_own_cart"
  },
  "release_stage": "current",
  "requires": [
    "reviewed_mapping",
    "contract_test",
    "policy",
    "runtime_activation",
    "ownership",
    "idempotency"
  ],
  "schemas": {
    "input": "schemas/cart/add_to_cart.input.json",
    "output": "schemas/cart/add_to_cart.output.json"
  },
  "side_effect": "write",
  "test_scenarios": [
    "happy: item added, totals recomputed, resource_revision incremented",
    "out-of-stock variant returns OUT_OF_STOCK",
    "stale expected_revision returns REVISION_CONFLICT",
    "idempotent retry with same action_id does not duplicate the line"
  ]
}
