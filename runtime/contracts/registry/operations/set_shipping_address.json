{
  "bindings": {
    "auteric_mcp": "set_shipping_address",
    "ucp": "dev.ucp.shopping.fulfillment"
  },
  "concurrency": {
    "applies_to": "checkout",
    "mode": "resource_revision"
  },
  "contract_version": "1.0.0",
  "description": "Set an authoritative checkout shipping destination.",
  "idempotency": "required",
  "identity": "buyer_or_guest_principal",
  "merchant_http": {
    "method": "PUT",
    "path": "/api/auteric/v1/checkouts/{checkout_id}/shipping-address"
  },
  "operation": "set_shipping_address",
  "ownership": {
    "resource": "checkout",
    "rule": "principal_must_own_checkout"
  },
  "release_stage": "current",
  "requires": [
    "reviewed_mapping",
    "contract_test",
    "policy",
    "runtime_activation",
    "ownership",
    "idempotency"
  ],
  "schemas": {
    "input": "schemas/checkout/set_shipping_address.input.json",
    "output": "schemas/checkout/set_shipping_address.output.json"
  },
  "side_effect": "write",
  "test_scenarios": [
    "happy: address stored, shipping/tax totals recomputed",
    "undeliverable region returns INVALID_INPUT with reason in message",
    "stale expected_revision returns REVISION_CONFLICT",
    "terminal checkout rejects address changes"
  ]
}
