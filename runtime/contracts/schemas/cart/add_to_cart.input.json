{
  "$id": "https://contracts.auteric.dev/schemas/cart/add_to_cart.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "minimum": 0,
      "type": "integer"
    },
    "product_id": {
      "$ref": "../common/ids.json#/$defs/product_id"
    },
    "quantity": {
      "maximum": 999,
      "minimum": 1,
      "type": "integer"
    },
    "variant_id": {
      "$ref": "../common/ids.json#/$defs/variant_id"
    }
  },
  "required": [
    "product_id",
    "quantity"
  ],
  "type": "object"
}
