{
  "$id": "https://contracts.auteric.dev/schemas/checkout/list_payment_methods.output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "has_more": {
      "type": "boolean"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "card",
              "bank_transfer",
              "wallet",
              "gift_card"
            ],
            "type": "string"
          },
          "label": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "payment_method_id": {
            "pattern": "^pm_[A-Za-z0-9]{8,64}$",
            "type": "string"
          }
        },
        "required": [
          "payment_method_id",
          "kind",
          "label"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array"
    },
    "next_cursor": {
      "$ref": "../common/ids.json#/$defs/cursor"
    }
  },
  "required": [
    "items",
    "has_more"
  ],
  "type": "object"
}
