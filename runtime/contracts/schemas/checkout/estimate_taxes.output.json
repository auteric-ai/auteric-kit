{
  "$id": "https://contracts.auteric.dev/schemas/checkout/estimate_taxes.output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checkout_id": {
      "$ref": "../common/ids.json#/$defs/checkout_id"
    },
    "estimated": {
      "type": "boolean"
    },
    "lines": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "$ref": "../common/money.json"
          },
          "label": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "rate_basis_points": {
            "maximum": 10000,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "label",
          "amount"
        ],
        "type": "object"
      },
      "maxItems": 50,
      "minItems": 0,
      "type": "array"
    },
    "tax_total": {
      "$ref": "../common/money.json"
    }
  },
  "required": [
    "checkout_id",
    "tax_total",
    "lines",
    "estimated"
  ],
  "type": "object"
}
