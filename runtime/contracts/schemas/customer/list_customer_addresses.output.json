{
  "$id": "https://contracts.auteric.dev/schemas/customer/list_customer_addresses.output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "has_more": {
      "type": "boolean"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "$ref": "../common/address.json"
          },
          "address_id": {
            "$ref": "customer.json#/$defs/address_id"
          }
        },
        "required": [
          "address_id",
          "address"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array"
    },
    "next_cursor": {
      "$ref": "../common/ids.json#/$defs/cursor"
    }
  },
  "required": [
    "items",
    "has_more"
  ],
  "type": "object"
}
