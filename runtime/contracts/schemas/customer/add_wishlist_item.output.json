{
  "$id": "https://contracts.auteric.dev/schemas/customer/add_wishlist_item.output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "added_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "product_id": {
      "$ref": "../common/ids.json#/$defs/product_id"
    }
  },
  "required": [
    "product_id",
    "added_at"
  ],
  "type": "object"
}
