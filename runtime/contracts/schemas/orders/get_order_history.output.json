{
  "$id": "https://contracts.auteric.dev/schemas/orders/get_order_history.output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "has_more": {
      "type": "boolean"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "event": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "occurred_at": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "type": "string"
          }
        },
        "required": [
          "event",
          "occurred_at"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array"
    },
    "next_cursor": {
      "$ref": "../common/ids.json#/$defs/cursor"
    }
  },
  "required": [
    "items",
    "has_more"
  ],
  "type": "object"
}
