{
  "$id": "https://contracts.auteric.dev/schemas/catalog/brand.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "brand_id": {
      "pattern": "^brand_[A-Za-z0-9]{8,64}$",
      "type": "string"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "brand_id",
    "name"
  ],
  "type": "object"
}
