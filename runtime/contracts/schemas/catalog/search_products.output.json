  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "page": {
      "$ref": "../common/pagination.json"
    },
    "results": {
      "items": {
        "$ref": "../common/product.json"
      },
      "maxItems": 100,
      "minItems": 0,
