{
  "$id": "https://contracts.auteric.dev/schemas/catalog/list_brands.output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "has_more": {
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "brand.json"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array"
    },
    "next_cursor": {
      "$ref": "../common/ids.json#/$defs/cursor"
    }
  },
  "required": [
    "items",
    "has_more"
  ],
  "type": "object"
}
