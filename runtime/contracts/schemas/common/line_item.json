{
  "$id": "https://contracts.auteric.dev/schemas/common/line_item.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "line_id": {
      "$ref": "ids.json#/$defs/line_id"
    },
    "product_id": {
      "$ref": "ids.json#/$defs/product_id"
    },
    "quantity": {
      "maximum": 999,
      "minimum": 1,
      "type": "integer"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
    },
    "total_price": {
      "$ref": "money.json"
    },
    "unit_price": {
      "$ref": "money.json"
    },
    "variant_id": {
      "$ref": "ids.json#/$defs/variant_id"
    }
  },
  "required": [
    "line_id",
    "product_id",
    "title",
    "quantity",
    "unit_price",
    "total_price"
  ],
  "type": "object"
}
