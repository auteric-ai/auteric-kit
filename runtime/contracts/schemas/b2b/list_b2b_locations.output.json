{
  "$id": "https://contracts.auteric.dev/schemas/b2b/list_b2b_locations.output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "has_more": {
      "type": "boolean"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "$ref": "../common/address.json"
          },
          "location_id": {
            "$ref": "company.json#/$defs/location_id"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "location_id",
          "name",
          "address"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array"
    },
    "next_cursor": {
      "$ref": "../common/ids.json#/$defs/cursor"
    }
  },
  "required": [
    "items",
    "has_more"
  ],
  "type": "object"
}
