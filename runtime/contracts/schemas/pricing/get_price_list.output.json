{
  "$id": "https://contracts.auteric.dev/schemas/pricing/get_price_list.output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "price": {
            "$ref": "../common/money.json"
          },
          "variant_id": {
            "$ref": "../common/ids.json#/$defs/variant_id"
          }
        },
        "required": [
          "variant_id",
          "price"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array"
    },
    "has_more": {
      "type": "boolean"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "next_cursor": {
      "$ref": "../common/ids.json#/$defs/cursor"
    },
    "price_list_id": {
      "pattern": "^plist_[A-Za-z0-9]{8,64}$",
      "type": "string"
    }
  },
  "required": [
    "price_list_id",
    "name",
    "currency",
    "entries",
    "has_more"
  ],
  "type": "object"
}
